{
  "name": "diffwise",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that reviews pull requests against repo-defined rules",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "diffwise": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "concepts": "tsx scripts/concepts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
