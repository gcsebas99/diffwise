// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildInitialMessage > matches the snapshot: wrapped title, body and file map, no diff 1`] = `
"Review this pull request.

Title:
<untrusted_pr_title>
Add order delete and patch routes
</untrusted_pr_title>

Description:
<untrusted_pr_description>
Adds two routes.
</untrusted_pr_description>

Changed files (3):
<untrusted_changed_files>
modified src/routes/orders.ts  rules: route-needs-test
added migrations/002_add_status.sql  rules: migration-reversible
