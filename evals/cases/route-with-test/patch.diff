+test("GET /orders?status= filters by status", async () => {
+  const { call, db } = setup();
+  await call("POST", "/orders", { userId: "usr_1", body: { totalCents: 100 } });
+  await call("POST", "/orders", { userId: "usr_1", body: { totalCents: 200 } });
+  const paid = db.orders.get("ord_2");
+  if (paid) paid.status = "paid";
+  const res = await call("GET", "/orders?status=paid", { userId: "usr_1" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(
+    (res.body as { orders: { id: string }[] }).orders.map((o) => o.id),
+    ["ord_2"],
+  );
+});
+
+test("GET /orders rejects an unknown status", async () => {
+  const { call } = setup();
+  const res = await call("GET", "/orders?status=lost", { userId: "usr_1" });
+  assert.equal(res.status, 400);
+});
