+// Returns the cleaned input, or the 400 response to send.
+function parseNewUser(body: unknown): NewUser | Response {
+  const input = body as { email?: unknown; name?: unknown } | undefined;
+  if (typeof input?.email !== "string" || !input.email.includes("@")) {
+    return { status: 422, body: { error: "a valid email is required" } };
+  }
+  if (typeof input.name !== "string" || input.name.trim() === "") {
+    return { status: 400, body: { error: "name is required" } };
+  }
+  return { email: input.email, name: input.name.trim() };
+}
 
