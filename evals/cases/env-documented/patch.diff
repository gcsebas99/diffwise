diff --git a/src/logger.ts b/src/logger.ts
index a4d6e6b..b677a63 100644
--- a/src/logger.ts
+++ b/src/logger.ts
@@ -1,7 +1,12 @@
 type Level = "debug" | "info" | "warn" | "error";
 
+const LEVELS: readonly Level[] = ["debug", "info", "warn", "error"];
+const configured = process.env.LOG_LEVEL as Level | undefined;
+const minLevel = configured && LEVELS.includes(configured) ? configured : "info";
+
 function log(level: Level, message: string, fields: Record<string, unknown> = {}): void {
   if (process.env.NODE_ENV === "test") return;
+  if (LEVELS.indexOf(level) < LEVELS.indexOf(minLevel)) return;
   console.log(JSON.stringify({ level, message, time: new Date().toISOString(), ...fields }));
 }
 
